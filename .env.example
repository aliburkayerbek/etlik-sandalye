# --- Zorunlu ---
# PostgreSQL bağlantısı (Neon / Supabase / yerel)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/sandalye?sslmode=require
# Yerel PostgreSQL'de SSL yoksa false yapın
DATABASE_SSL=true
# Oturum imzası: uzun rastgele metin -> node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# T.C./telefon şifreleme anahtarı (64 hex). KAYBETMEYİN: kaybolursa şifreli veriler okunamaz.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# --- İlk açılış ---
# Veritabanında admin yoksa bu bilgilerle oluşturulur. Girişten sonra şifreyi değiştirin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- İsteğe bağlı ---
# QR kodlarına basılacak adres. Boşsa isteğin geldiği adres kullanılır.
# Canlıya geçince kalıcı alan adınızı yazın, etiketleri ondan sonra basın.
PUBLIC_BASE_URL=https://etlik-sandalye.onrender.com
NODE_ENV=production
PORT=3000
